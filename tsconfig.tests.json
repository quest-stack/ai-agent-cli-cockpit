{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmitOnError": true,
    "outDir": "dist-tests",
    "rootDir": ".",
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/electron/project-scanner.ts",
    "src/electron/status-detector.ts",
    "src/shared/**/*.ts",
    "tests/unit/**/*.ts"
  ]
}
